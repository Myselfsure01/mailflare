# Copy to .env.docker and fill in real values. NEVER commit .env.docker.
# Public base URL of the deployment.
APP_URL=https://mail.example.com
# Inbound SMTP listener port inside the container (unused in relay mode,
# kept for parity with the upstream image defaults).
SMTP_INBOUND_PORT=25
# Shared HMAC secret between the email relay Worker and this server.
# Must match the INBOUND_WEBHOOK_SECRET secret set on the relay Worker.
INBOUND_WEBHOOK_SECRET=change-me-long-random-string
# Optional outbound SMTP URL (sending is normally handled per-domain via
# Resend inside the app; leave empty unless you use SMTP sending).
SMTP_URL=
# Require signed relay headers on /api/inbound (keep 1 in relay mode).
INBOUND_REQUIRE_SIGNED_HEADERS=1
# Scoped Cloudflare API token for the app's domain page integration:
# zone-scoped Zone Read, DNS Write, Email Routing Rules RW, plus account
# Email Routing Addresses RW / Account Rules Read. Do NOT use a Global Key.
CF_TOKEN=
# AI assistant via Cloudflare Workers AI REST (OpenAI-compatible route).
# AI_BASE_URL points at the models shim (deploy/ai-models-shim.nginx.conf)
# on this host; the app resolves the env key only when the saved agent
# base URL equals AI_BASE_URL exactly.
AI_BASE_URL=https://ai.example.com/v1
AI_API_KEY=
AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Official Workers AI usage card on the admin AI-usage page (optional):
# account ID plus a SEPARATE scoped token with only Account Analytics
# Read + Workers AI Read (account-level). Leave empty to hide the card.
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
