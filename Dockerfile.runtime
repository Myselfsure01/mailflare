# Runtime-only image assembled from host-built artifacts (mirrors the upstream
# Dockerfile's runtime stage exactly; build stages ran on the host because this
# VM has no Docker daemon and the sandbox egress intercepts TLS).
FROM node:22-bookworm-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 MAILFLARE_RUNTIME=node
ENV NODE_ENV=production DATA_DIR=/data PORT=3000 SMTP_INBOUND_PORT=25
COPY --chown=node:node node_modules ./node_modules
COPY --chown=node:node .next-node ./.next-node
COPY --chown=node:node dist ./dist
COPY --chown=node:node public ./public
COPY --chown=node:node drizzle ./drizzle
COPY --chown=node:node package.json next.config.ts ./
COPY --chown=node:node src/lib/security/headers.ts ./src/lib/security/headers.ts
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME ["/data"]
EXPOSE 3000 25
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/setup/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.mjs"]
